#!/usr/bin/bash
# Tear down the NAT routing that was setup when the WG VPN was started

# raspbian and ubuntu have merged /sbin into /usr/sbin
IPT="/usr/sbin/iptables"
IPT6="/usr/sbin/ip6tables"
IP="/usr/sbin/ip"

$IPT --table mangle --delete OUTPUT --jump MARK --set-mark 1
$IP -4 rule delete fwmark 1 table main
$IPT --table mangle --delete PREROUTING --in-interface {{ wired_if }} --jump MARK --set-mark 2

## IPv4 ##
$IPT --table nat --delete POSTROUTING --source {{ wired_cidr }} --out-interface {{ vpn_if }} --jump MASQUERADE
$IPT --delete INPUT --in-interface {{ vpn_if }} --jump ACCEPT
$IPT --delete FORWARD --in-interface {{ wired_if }} --out-interface {{ vpn_if }} --jump ACCEPT
$IPT --delete FORWARD --in-interface {{ vpn_if }} --out-interface {{ wired_if }} --jump ACCEPT

$IPT --delete INPUT --in-interface {{ public_if }} --protocol udp --dport {{ public_if_port }} --jump ACCEPT
$IPT --table nat --delete POSTROUTING --source {{ server_cidr }} --out-interface {{ public_if }} --jump MASQUERADE

